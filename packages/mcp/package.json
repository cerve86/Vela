{
  "name": "@vela/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP server that lets Claude draft programmes into a Vela coach's account",
  "type": "module",
  "bin": {
    "vela-mcp": "./dist/vela-mcp.cjs"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/vela-mcp.cjs --log-level=warning",
    "pack": "npm run build && node scripts/pack.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vela/shared": "*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
