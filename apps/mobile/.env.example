# Local Supabase stack. The anon key is a public credential by design — it ships inside
# the app and every table it can reach is guarded by row level security.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The coach portal, which brokers Strava and serves calendar feeds. Local dev server by default.
EXPO_PUBLIC_PORTAL_URL=http://localhost:4310
