{
  "name": "coachapp",
  "version": "0.1.0",
  "private": true,
  "description": "Physiotherapy coaching platform — iOS client app + coach web portal",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@coachapp/web",
    "dev:web": "npm run dev --workspace=@coachapp/web",
    "dev:mobile": "npm run start --workspace=@coachapp/mobile",
    "ios": "npm run ios --workspace=@coachapp/mobile",
    "build": "npm run build --workspace=@coachapp/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
