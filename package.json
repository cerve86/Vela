{
  "name": "vela",
  "version": "0.1.0",
  "private": true,
  "description": "Physiotherapy coaching platform \u2014 iOS client app + coach web portal",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@vela/web",
    "dev:web": "npm run dev --workspace=@vela/web",
    "dev:mobile": "npm run start --workspace=@vela/mobile",
    "ios": "npm run ios --workspace=@vela/mobile",
    "build": "npm run build --workspace=@vela/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "seed": "node scripts/seed-demo.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "mcp:pack": "npm run pack -w @vela/mcp"
  },
  "devDependencies": {
    "eas-cli": "^22.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
